{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bitz-flow/worktree-v2/mutation-receipt/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "operation_id", "target_collision_key", "receipt_state", "event_digest", "supersedes_receipt_digest", "fencing_token"],
  "properties": {
    "contract_version": {"type": "integer", "const": 2},
    "operation_id": {"type": "string", "minLength": 1},
    "target_collision_key": {"type": "string", "minLength": 1},
    "receipt_state": {"type": "string", "enum": ["INDETERMINATE", "TERMINAL"]},
    "event_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "supersedes_receipt_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "fencing_token": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$"}
  }
}
