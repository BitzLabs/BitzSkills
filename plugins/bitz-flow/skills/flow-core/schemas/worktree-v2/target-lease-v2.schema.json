{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bitz-flow/worktree-v2/target-lease/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "operation_id", "target_collision_key", "fencing_token", "nonce_digest", "state"],
  "properties": {
    "contract_version": {"type": "integer", "const": 2},
    "operation_id": {"type": "string", "minLength": 1},
    "target_collision_key": {"type": "string", "minLength": 1},
    "fencing_token": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$"},
    "nonce_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "state": {"type": "string", "enum": ["ACTIVE", "RELEASED"]}
  }
}
