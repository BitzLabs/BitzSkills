{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bitz-flow/worktree-v2/operation-event/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "operation_id", "target_collision_key", "sequence", "previous_event_digest", "state", "fencing_token"],
  "properties": {
    "contract_version": {"type": "integer", "const": 2},
    "operation_id": {"type": "string", "minLength": 1},
    "target_collision_key": {"type": "string", "minLength": 1},
    "sequence": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$"},
    "previous_event_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "state": {"type": "string", "enum": ["LOCKED", "INTENT_DURABLE", "MUTATING", "RESULT_DURABLE", "DONE", "QUARANTINED"]},
    "fencing_token": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$"}
  }
}
