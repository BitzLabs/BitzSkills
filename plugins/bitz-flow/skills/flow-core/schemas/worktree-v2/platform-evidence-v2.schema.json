{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bitz-flow/worktree-v2/platform-evidence/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "profile_version",
    "platform",
    "filesystem_type",
    "filesystem_class",
    "owner_principal",
    "owner_matches",
    "acl_owner_only",
    "non_follow_walk",
    "resource_kind",
    "resource_identity",
    "native_component",
    "case_semantics",
    "os_lock",
    "file_durability",
    "directory_durability",
    "child_supervision",
    "semantic_self_test",
    "support_code",
    "reasons"
  ],
  "properties": {
    "contract_version": {"type": "integer", "const": 2},
    "profile_version": {"type": "integer", "const": 1},
    "platform": {"type": "string", "enum": ["linux", "macos", "windows"]},
    "filesystem_type": {"type": "string", "minLength": 1},
    "filesystem_class": {"type": "string", "enum": ["local", "network", "unknown"]},
    "owner_principal": {"type": ["string", "null"]},
    "owner_matches": {"type": "boolean"},
    "acl_owner_only": {"type": "boolean"},
    "non_follow_walk": {"type": "boolean"},
    "resource_kind": {"type": "string", "enum": ["file", "directory"]},
    "resource_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "native_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "encoding", "value"],
      "properties": {
        "platform": {"type": "string", "enum": ["posix", "windows"]},
        "encoding": {"type": "string", "enum": ["bytes-base64url", "utf16le-base64url"]},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]*$"}
      }
    },
    "case_semantics": {"type": "string", "enum": ["sensitive", "insensitive"]},
    "os_lock": {"type": "boolean"},
    "file_durability": {"type": "boolean"},
    "directory_durability": {"type": "boolean"},
    "child_supervision": {"type": "boolean"},
    "semantic_self_test": {"type": "boolean"},
    "support_code": {"type": "string", "enum": ["SUPPORTED", "UNSUPPORTED_FILESYSTEM"]},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
