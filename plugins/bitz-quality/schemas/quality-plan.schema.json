{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "advisory", "planningStatus", "subjectCommit", "originIds", "goal", "risk", "flow", "independentReviewPlanned", "evidencePlan", "openQuestions", "stopConditions", "humanDecisionPending"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "kind": {"const": "quality-plan"},
    "advisory": {"const": true},
    "planningStatus": {"enum": ["proposed", "needs_information", "blocked"]},
    "subjectCommit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "originIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "goal": {"type": "string", "minLength": 1},
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["band", "rationale", "areas", "downgradeApproval"],
      "properties": {
        "band": {"enum": ["Q0", "Q1", "Q2", "Q3", null]},
        "rationale": {"type": "string", "minLength": 1},
        "areas": {
          "type": "object", "additionalProperties": false,
          "required": ["function", "data", "security", "compatibility", "reliability", "performance", "supply-chain", "operations"],
          "properties": {
            "function": {"$ref": "#/$defs/riskArea"}, "data": {"$ref": "#/$defs/riskArea"},
            "security": {"$ref": "#/$defs/riskArea"}, "compatibility": {"$ref": "#/$defs/riskArea"},
            "reliability": {"$ref": "#/$defs/riskArea"}, "performance": {"$ref": "#/$defs/riskArea"},
            "supply-chain": {"$ref": "#/$defs/riskArea"}, "operations": {"$ref": "#/$defs/riskArea"}
          }
        },
        "downgradeApproval": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["reason", "approvedBy", "approvalReference"],
          "properties": {"reason": {"type": "string", "minLength": 1}, "approvedBy": {"type": "string", "minLength": 1}, "approvalReference": {"type": "string", "minLength": 1}}
        }
      }
    },
    "flow": {"enum": ["simple", "full", "spike", null]},
    "independentReviewPlanned": {"type": "boolean"},
    "evidencePlan": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidenceId", "priority", "reason", "checksCondition", "method", "command", "cwd", "safetyPrerequisites", "owner"],
        "properties": {
          "evidenceId": {"type": "string", "minLength": 1},
          "priority": {"enum": ["required", "recommended", "not_applicable"]},
          "reason": {"type": "string", "minLength": 1},
          "checksCondition": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "command": {"type": ["array", "null"], "minItems": 1, "items": {"type": "string"}},
          "cwd": {"type": ["string", "null"]},
          "safetyPrerequisites": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "owner": {"type": ["string", "null"], "minLength": 1}
        }
      }
    },
    "openQuestions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "stopConditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "humanDecisionPending": {"const": true}
  },
  "$defs": {
    "riskArea": {
      "type": "object", "additionalProperties": false, "required": ["minimumBand", "rationale", "openQuestions"],
      "properties": {"minimumBand": {"enum": ["Q0", "Q1", "Q2", "Q3", null]}, "rationale": {"type": "string", "minLength": 1}, "openQuestions": {"type": "array", "items": {"type": "string", "minLength": 1}}}
    }
  }
}
