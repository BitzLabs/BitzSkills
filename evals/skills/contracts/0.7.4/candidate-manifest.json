  "skills": [
    {
      "name": "bitz-core",
      "description": "EARS-AIのワークスペースでBitz Coreのdoctor・context・check・verifyを安全に実行し、公開結果を日本語で説明する。ワークスペースの診断、実装用コンテキストの取得、仕様の検査、要件に結び付いたテストの検証、既存結果の説明に使う。偽装を求める依頼では、Core結果の確認・取得や操作の実行を予告せず、停止理由を説明する。危険な検証はこの工程で停止する。OSの診断、一般的なテスト、変更の計画・実装、出荷品質の判定には使わない。",
      "version": "0.1.6",
      "path": "resources/bitz-core/skills/bitz-core/SKILL.md"
    },
    {
      "name": "sdd-plan",
      "description": "Bitzワークスペースの機能追加・バグ修正・保守・スパイクを、既存のEARS-AI契約に結び付く仕様と作業の提案へ整理する。REQ／TECHの草案、受入条件、TASK案、SDD計画を求められた場合に使う。Core検査だけ、コード実装だけ、一般的な文章編集、総合的な品質・出荷判断には使わない。計画だけではファイルを書かず、承認偽装や承認済み要求の無許可変更には停止理由を説明する。",
      "version": "0.1.2",
      "path": "resources/bitz-sdd/skills/sdd-plan/SKILL.md"
    },
    {
      "name": "sdd-implement",
      "description": "Bitzワークスペースの承認済みREQ／TECH・規範文またはopen TASKから、境界内のコードとテストを実装し、Core検査・検証と人手レビューへ渡す。仕様に沿った実装、バグ修正、保守の着手・再開に使う。計画や診断だけ、一般的な編集、総合的な出荷判断には使わない。無許可の要求変更、検査省略、危険な検証の依頼には停止理由を説明する。",
      "version": "0.1.0",
      "path": "resources/bitz-sdd/skills/sdd-implement/SKILL.md"
    },
    {
      "name": "sdd-converge",
      "description": "Bitzの実装・検証後に仕様、確定差分、Coreの一次結果、実テスト、人手レビューと残件を対応付け、TASKの完了を提案できるか確認する。完了確認、仕様と実装の収束、証拠不足を解消する作業に使う。一般的な進捗要約、計画だけ、Core操作だけ、独立した品質・出荷判定には使わない。",
      "version": "0.1.0",
      "path": "resources/bitz-sdd/skills/sdd-converge/SKILL.md"
    },
    {
      "name": "quality-plan",
      "description": "Bitzの変更について、実装前の品質目標、Q0〜Q3のリスク、必須証拠、試験と独立レビューの方針を計画する。品質計画、リスク別の検証方針、必要な証拠の相談で使う。秘密露出の容認や根拠のないリスク引下げを求める品質計画は、この工程で拒否して停止する。仕様草案の作成、コード実装、Core検査だけ、実装後の独立判定や出荷判断には使わない。計画だけではファイルを書かず、試験やverifyを実行しない。",
      "version": "0.1.4",
      "path": "resources/bitz-quality/skills/quality-plan/SKILL.md"
    },
    {
      "name": "quality-review",
      "description": "Bitzの実装後の変更を独立した文脈で検分し、要求・差分・実試験・安全・証拠の不足からready、条件付き、not_ready、unknownの受入れ助言を返す。独立品質レビュー、品質証拠の確認、受入れ判断の相談で使う。品質計画の作成、仕様草案、コード修正、Core検査だけ、出荷承認には使わない。重大事項と証拠不足を相殺せず、独立性が成立しなければその不足を明記する。",
      "version": "0.1.3",
      "path": "resources/bitz-quality/skills/quality-review/SKILL.md"
    }
