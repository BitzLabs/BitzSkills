{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "status", "independent", "implementationPrivateHistoryInherited", "reviewRunId", "comparisonRunId", "sourceCommit", "subjectCommit", "runSha256", "checks", "directChecks", "reason"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "status": {"enum": ["passed", "failed", "unknown"]},
    "independent": {"const": true},
    "implementationPrivateHistoryInherited": {"const": false},
    "reviewRunId": {"type": "string", "minLength": 1},
    "comparisonRunId": {"type": "string", "minLength": 1},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "subjectCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks": {"type": "object", "additionalProperties": false, "required": ["mechanical", "safety", "evidence", "semantic"], "properties": {
      "mechanical": {"enum": ["passed", "failed", "unknown"]}, "safety": {"enum": ["passed", "failed", "unknown"]},
      "evidence": {"enum": ["passed", "failed", "unknown"]}, "semantic": {"enum": ["passed", "failed", "unknown"]}
    }},
    "directChecks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reason": {"type": "string", "minLength": 1}
  }
}
