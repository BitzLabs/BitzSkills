{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "setVersion", "casesSha256", "publicCasesConsidered", "excludedCasesConsidered", "comparisons"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "setVersion": {"enum": ["production-routing-held-out-0.2.0", "production-routing-held-out-0.3.0"]},
    "casesSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publicCasesConsidered": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"type": "string", "pattern": "^SE-[0-9]{3,}$"}},
    "excludedCasesConsidered": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"type": "string", "pattern": "^SE-[0-9]{3,}$"}},
    "comparisons": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["caseId", "primaryDecision", "causalPreconditions", "requestedAction", "stoppingReason", "nearestPublicCaseIds", "nearestExcludedCaseIds", "decisionRelevantDifferences", "sameDecisionUnderSamePremises", "differenceChangesDecisionOrScope"],
        "properties": {
          "caseId": {"type": "string", "pattern": "^SE-(9[0-9]{2}|10[0-9]{2})$"},
          "primaryDecision": {"type": "string", "minLength": 1},
          "causalPreconditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "requestedAction": {"type": "string", "minLength": 1},
          "stoppingReason": {"type": "string", "minLength": 1},
          "nearestPublicCaseIds": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"type": "string", "pattern": "^SE-[0-9]{3,}$"}},
          "nearestExcludedCaseIds": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"type": "string", "pattern": "^SE-[0-9]{3,}$"}},
          "decisionRelevantDifferences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "sameDecisionUnderSamePremises": {"const": false},
          "differenceChangesDecisionOrScope": {"const": true}
        }
      }
    }
  }
}
