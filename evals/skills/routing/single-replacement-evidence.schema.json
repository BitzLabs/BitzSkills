    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "anchor"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
