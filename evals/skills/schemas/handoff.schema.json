{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "subjectCommit", "originIds", "changedPaths", "risk", "requiredEvidence", "collectedEvidence", "missingEvidence", "checks"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "subjectCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "originIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "changedPaths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}},
    "risk": {"type": "object", "additionalProperties": false, "required": ["band", "dimensions", "rationale"], "properties": {"band": {"enum": ["Q0", "Q1", "Q2", "Q3"]}, "dimensions": {"type": "array", "uniqueItems": true, "items": {"enum": ["security", "privacy", "reliability", "compatibility", "performance", "supply-chain", "operations", "maintainability"]}}, "rationale": {"type": "string", "minLength": 1}}},
    "requiredEvidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "collectedEvidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "missingEvidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["evidenceId", "reason"], "properties": {"evidenceId": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}}},
    "checks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "command", "result"], "properties": {"name": {"type": "string"}, "command": {"type": ["array", "null"], "items": {"type": "string"}}, "result": {"enum": ["passed", "failed", "blocked", "not-run"]}}}}
  },
  "$defs": {"evidence": {"type": "object", "additionalProperties": false, "required": ["evidenceId", "kind", "source", "sha256"], "properties": {"evidenceId": {"type": "string", "minLength": 1}, "kind": {"enum": ["core-result", "test-result", "diff", "review", "benchmark", "provenance"]}, "source": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
