{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "independent-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "implementationRunId", "reviewRunId", "subjectCommit", "freshContext", "implementationPrivateHistoryInherited", "leadingConclusionProvided", "inputs", "directChecks", "notRerun", "independent"],
  "properties": {
    "schemaVersion": {"const": "1.0"}, "implementationRunId": {"type": "string", "minLength": 1}, "reviewRunId": {"type": "string", "minLength": 1},
    "subjectCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "freshContext": {"type": "boolean"}, "implementationPrivateHistoryInherited": {"type": "boolean"}, "leadingConclusionProvided": {"type": "boolean"},
    "inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "directChecks": {"type": "array", "items": {"type": "string"}},
    "notRerun": {"type": "array", "items": {"type": "object", "required": ["check", "reason"], "properties": {"check": {"type": "string"}, "reason": {"type": "string"}}}},
    "independent": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"independent": {"const": true}}, "required": ["independent"]},
      "then": {
        "properties": {
          "freshContext": {"const": true},
          "implementationPrivateHistoryInherited": {"const": false},
          "leadingConclusionProvided": {"const": false},
          "directChecks": {"minItems": 1}
        }
      }
    }
  ]
}
