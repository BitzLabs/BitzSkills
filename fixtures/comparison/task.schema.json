{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "Bitz Core 1.0 comparison task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "title", "objective", "baselineMode", "brief", "conditions", "completionCriteria", "metricTags"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "1.0"},
    "taskId": {"type": "string", "pattern": "^CMP-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "baselineMode": {"enum": ["markdown", "legacy-ears"]},
    "brief": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "bitz"],
      "properties": {
        "baseline": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "bitz": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "completionCriteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "metricTags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["completionMs", "authoringMs", "reviewMs", "detectedDefects"]}
    }
  }
}
