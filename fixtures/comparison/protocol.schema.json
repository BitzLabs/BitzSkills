{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comparison-protocol.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "taskIds", "minimumParticipantsPerCondition", "assignment", "controls", "metrics", "successCriteria"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "1.0"},
    "protocolVersion": {"const": "1.0"},
    "taskIds": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^CMP-[0-9]{3}$"}},
    "minimumParticipantsPerCondition": {"type": "integer", "minimum": 1},
    "assignment": {"const": "balanced-ab-ba"},
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "externalAssistance", "timeStarts", "timeStops", "blindReview"],
      "properties": {
        "network": {"const": false}, "externalAssistance": {"const": false},
        "timeStarts": {"type": "string"}, "timeStops": {"type": "string"}, "blindReview": {"const": true}
      }
    },
    "metrics": {"type": "array", "const": ["completionMs", "authoringMs", "reviewMs", "detectedDefects"]},
    "successCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allSubmittedDeliverablesAccepted", "criticalDefectRecallPercent", "maximumMedianRegressionPercentPerTimeMetric", "minimumImprovedTimeMetricPercent", "alternativeImprovement"],
      "properties": {
        "allSubmittedDeliverablesAccepted": {"const": true},
        "criticalDefectRecallPercent": {"const": 100},
        "maximumMedianRegressionPercentPerTimeMetric": {"type": "number", "minimum": 0},
        "minimumImprovedTimeMetricPercent": {"type": "number", "minimum": 0},
        "alternativeImprovement": {"type": "string", "minLength": 1}
      }
    }
  }
}
