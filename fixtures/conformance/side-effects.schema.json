{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fixtureの副作用期待値",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policy"
  ],
  "oneOf": [
    {
      "required": [
        "before",
        "after"
      ],
      "not": {
        "required": [
          "stateDigest"
        ]
      }
    },
    {
      "required": [
        "stateDigest"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "before"
            ]
          },
          {
            "required": [
              "after"
            ]
          }
        ]
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "stateDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "生成fixtureの実行前後の観測値のCanonical JSONのSHA-256。file単位の一覧の代わりに使う。"
    },
    "policy": {
      "enum": [
        "read-only",
        "explicit-report"
      ],
      "description": "read-only: 実行は何も作成・更新・削除しない。explicit-report: 実行はさらにreport.directoryの下にreport.createdCount件のfileを作成する。report file名は生成時刻と連番を含むのでここでは名指しできない。そのためbeforeとafterは既に存在したpathだけを記述し、それらはすべて不変でなければならない。"
    },
    "before": {
      "$ref": "#/$defs/state"
    },
    "after": {
      "$ref": "#/$defs/state"
    },
    "report": {
      "$ref": "#/$defs/report"
    }
  },
  "$defs": {
    "entry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "directory"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "executable",
            "sha256"
          ],
          "properties": {
            "kind": {
              "const": "file"
            },
            "executable": {
              "type": "boolean"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "symlink"
            },
            "target": {
              "type": "string"
            }
          }
        }
      ]
    },
    "tree": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      },
      "propertyNames": {
        "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\u0000).+$"
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "git",
        "home",
        "cache",
        "temporary"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/tree"
        },
        "git": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "status",
            "index"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "index": {
              "type": "string"
            }
          }
        },
        "home": {
          "$ref": "#/$defs/tree"
        },
        "cache": {
          "$ref": "#/$defs/tree"
        },
        "temporary": {
          "$ref": "#/$defs/tree"
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "createdCount",
        "namePattern",
        "temporaryFilesRemaining"
      ],
      "properties": {
        "directory": {
          "const": ".spec/reports"
        },
        "createdCount": {
          "type": "integer",
          "minimum": 1
        },
        "namePattern": {
          "type": "string",
          "minLength": 1
        },
        "temporaryFilesRemaining": {
          "const": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "policy": {
            "const": "explicit-report"
          }
        },
        "required": [
          "policy"
        ]
      },
      "then": {
        "required": [
          "report"
        ]
      },
      "else": {
        "not": {
          "required": [
            "report"
          ]
        }
      }
    }
  ]
}
