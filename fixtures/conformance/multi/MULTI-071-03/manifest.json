{
  "fixtureId": "MULTI-071-03",
  "description": "途中のコミットの間にメンバーのルートを移せば、移す前のコミットのdraftの版を対応付けず違反のままにする",
  "setup": {
    "git": true,
    "baseCommit": {
      "message": "base",
      "paths": [
        "."
      ]
    },
    "operations": [
      {
        "op": "branch",
        "name": "base"
      },
      {
        "op": "update",
        "path": "apps/web/.spec/requirements/REQ-010.md",
        "source": "changes/draft.md"
      },
      {
        "op": "stage",
        "paths": [
          "apps/web/.spec/requirements/REQ-010.md"
        ]
      },
      {
        "op": "commit",
        "message": "draft web"
      },
      {
        "op": "rename",
        "from": "apps/web",
        "to": "apps/site"
      },
      {
        "op": "update",
        "path": ".spec/bitz.yaml",
        "source": "changes/root.yaml"
      },
      {
        "op": "update",
        "path": "apps/site/.spec/requirements/REQ-010.md",
        "source": "changes/approved.md"
      },
      {
        "op": "stage",
        "paths": [
          "apps/web",
          "apps/site",
          ".spec/bitz.yaml"
        ]
      },
      {
        "op": "commit",
        "message": "move web and approve"
      }
    ]
  },
  "invocation": {
    "runner": "bitz",
    "cwd": ".",
    "argv": [
      "check",
      "--all-workspaces",
      "--base",
      "base",
      "--format",
      "json"
    ],
    "env": {}
  },
  "expect": {
    "status": "failed",
    "exitCode": 1,
    "stdout": "json",
    "resultFile": "expected/check.json",
    "reportFileCount": 0
  }
}
