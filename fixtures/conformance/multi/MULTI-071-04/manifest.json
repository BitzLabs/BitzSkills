{
  "fixtureId": "MULTI-071-04",
  "description": "メンバーのルートを移したコミットのdraftの版は、移す前の親に同じIDの文書がないので状態を変えた版として認める",
  "setup": {
    "git": true,
    "baseCommit": {
      "message": "base",
      "paths": [
        "."
      ]
    },
    "operations": [
      {
        "op": "branch",
        "name": "base"
      },
      {
        "op": "update",
        "path": "apps/web/.spec/requirements/REQ-010.md",
        "source": "changes/draft.md"
      },
      {
        "op": "stage",
        "paths": [
          "apps/web/.spec/requirements/REQ-010.md"
        ]
      },
      {
        "op": "commit",
        "message": "draft web"
      },
      {
        "op": "rename",
        "from": "apps/web",
        "to": "apps/site"
      },
      {
        "op": "update",
        "path": ".spec/bitz.yaml",
        "source": "changes/root.yaml"
      },
      {
        "op": "stage",
        "paths": [
          "apps/web",
          "apps/site",
          ".spec/bitz.yaml"
        ]
      },
      {
        "op": "commit",
        "message": "move web"
      },
      {
        "op": "update",
        "path": "apps/site/.spec/requirements/REQ-010.md",
        "source": "changes/approved.md"
      },
      {
        "op": "stage",
        "paths": [
          "apps/site/.spec/requirements/REQ-010.md"
        ]
      },
      {
        "op": "commit",
        "message": "approve web"
      }
    ]
  },
  "invocation": {
    "runner": "bitz",
    "cwd": ".",
    "argv": [
      "check",
      "--all-workspaces",
      "--base",
      "base",
      "--format",
      "json"
    ],
    "env": {}
  },
  "expect": {
    "status": "passed",
    "exitCode": 0,
    "stdout": "json",
    "resultFile": "expected/check.json",
    "reportFileCount": 0
  }
}
